# Copy to watch/.env (never commit .env). Both are optional: without them the
# bot still detects moments (status "detected") but does not create clips.

# Twitch application client id (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=

# A *user* access token with the clips:edit scope, for the account that will
# own the clips. Plain token or "oauth:..." prefix, both accepted.
TWITCH_TOKEN=
