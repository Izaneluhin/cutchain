# cutchain/mint — copy to .env and fill in. NEVER commit .env.

# Robinhood Chain mainnet RPC (chain id 4663). Public endpoint is rate-limited; Alchemy is recommended:
#   https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Hex private key of the launcher wallet (0x-prefixed, 32 bytes). Only needed for live sends.
# Fund it with a little ETH on Robinhood Chain (launch fee — read live via factory.launchFee() — plus gas,
# plus any --dev-buy-eth). Leave empty for --dry-run.
PRIVATE_KEY=

# ---- Pons V2 (current launchpad) — defaults are the docs.ponsfamily.com/v2 addresses ----
# PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_V2_MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
# PONS_V2_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# PONS_V2_BUYBACK_VAULT=0x42df2a798f82289E177311362e8f5ccC45c1219c
# PONS_V2_LAUNCH_LOCKER=0x267444D099b10fB5Ed7c3Cc7B7c767AdcA574952
# PONS_V2_LAUNCH_AND_BUY=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948

# ---- Pons V1 (legacy scripts *-v1.ts) ----
# PONS_FACTORY=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
# PONS_LOCKER=0x736D76699C26D0d966744cAe304C000d471f7F35
# Optional: V1 locker claim signature once verified on the explorer, e.g. claimFees(address).
LOCKER_CLAIM_SIGNATURE=
# Optional: V1 creator fee wallet for launch-v1.ts (defaults to the sender).
FEE_WALLET=

# ---- Uniswap / tokens ----
# WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
# NONFUNGIBLE_POSITION_MANAGER=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
# AMZN=0x12f190a9f9d7d37a250758b26824b97ce941bf54
