# cutchain — every environment variable used by the three modules, in one place.
# Each module reads its OWN file: watch/.env, mint/.env, contracts/.env (copy the
# .env.example next to each). This root file is the index; values here are placeholders.
# Never commit a real .env. All .env files are gitignored.

# ---------------------------------------------------------------------------
# watch/.env  (watch/.env.example) — both optional; without them moments are
# detected (status "detected") but no Twitch clip is created.
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=            # Twitch application client id (dev.twitch.tv/console/apps)
TWITCH_TOKEN=                # user access token with the clips:edit scope; "oauth:" prefix accepted

# ---------------------------------------------------------------------------
# mint/.env  (mint/.env.example) — Pons V2 launch / status / claim / pool scripts
# ---------------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com   # Robinhood Chain RPC (chain id 4663); Alchemy recommended, public endpoint is rate-limited
PRIVATE_KEY=                 # 0x-prefixed launcher key; only needed for live sends, leave empty for --dry-run
# Optional address overrides; defaults are the docs.ponsfamily.com/v2 addresses listed in mint/.env.example
#PONS_V2_FACTORY=            # PonsV2LaunchFactory
#PONS_V2_MEME_HOOK=          # PonsV2MemeHook
#PONS_V2_FEE_ESCROW=         # Fee Escrow where creator fees accrue
#PONS_V2_BUYBACK_VAULT=      # PonsV2BuybackVault
#PONS_V2_LAUNCH_LOCKER=      # PonsV2LaunchLocker
#PONS_V2_LAUNCH_AND_BUY=     # PonsV2LaunchAndBuy router (docs-only ABI)
#PONS_FACTORY=               # Pons V1 factory (legacy *-v1.ts scripts)
#PONS_LOCKER=                # Pons V1 locker (legacy *-v1.ts scripts)
LOCKER_CLAIM_SIGNATURE=      # optional, V1 locker claim signature once verified on the explorer, e.g. claimFees(address)
FEE_WALLET=                  # optional, V1 creator fee wallet for launch-v1.ts (defaults to the sender)
#WETH=                       # WETH9 on Robinhood Chain
#UNISWAP_V3_FACTORY=         # Uniswap V3 factory (pool.ts)
#NONFUNGIBLE_POSITION_MANAGER=   # Uniswap V3 position manager (pool.ts)
#AMZN=                       # AMZN Stock Token, default quote of pool.ts

# ---------------------------------------------------------------------------
# contracts/.env  (contracts/.env.example) — Foundry deploy script + weekly cast commands
# ---------------------------------------------------------------------------
#RPC_URL=https://rpc.mainnet.chain.robinhood.com   # same name as in mint/.env; mainnet 4663 or testnet https://rpc.testnet.chain.robinhood.com (46630)
CHAIN_ID=4663                # 4663 mainnet, 46630 testnet
VERIFIER_URL=https://robinhoodchain.blockscout.com/api/   # Blockscout verifier API (testnet: https://explorer.testnet.chain.robinhood.com/api/)
#PRIVATE_KEY=                # deployer key and, for weekly ops, the distributor owner key; throwaway, funded with a little ETH
DEV=                         # CutPool recipient: dev wallet
TEAM=                        # CutPool recipient: team wallet
CLIPPER_POOL=                # CutPool recipient for clippers; empty = deploy a fresh MerkleDistributor and use it
BPS_DEV=                     # basis points to DEV
BPS_CLIPPER=                 # basis points to the clipper pool (MerkleDistributor)
BPS_TEAM=                    # basis points to TEAM; the three must sum to 10000
CLAIM_TARGET=                # mode B only: contract that pays creator fees to CutPool; empty for mode A
CLAIM_SELECTOR=              # mode B only: 4-byte selector of its claim function, left-aligned in 32 bytes (cast sig "<signature>")
DEPLOY_DISTRIBUTOR=true      # deploy MerkleDistributor in the same script run
DISTRIBUTOR_OWNER=           # owner that calls setRound / sweep every week; defaults to the deployer
#WETH=                       # WETH9, for unwrapWETH (same name as in mint/.env)
PONS_V1_FACTORY=             # Pons V1 factory address (reference, verify on the explorer)
PONS_V1_LOCKER=              # Pons V1 active locker address (reference, verify on the explorer)
